# Fonte de dados do catálogo de peças:
#   A = ficheiro JSON (backend/data/pecas.json)
#   B = API REST PHP (php/api_pecas.php)
#   C = MySQL direto (Base de Dados 1)  ← versão entregue / recomendada
FONTE_DADOS=C

# Base de Dados 1 — clientes, peças/stock e vendas (PHP)
DB1_HOST=127.0.0.1
DB1_PORT=3306
DB1_NAME=autolux_vendas
DB1_USER=autolux
DB1_PASS=autolux

# Base de Dados 2 — fornecedores e encomendas (Node.js)
DB2_HOST=127.0.0.1
DB2_PORT=3306
DB2_NAME=autolux_fornecedores
DB2_USER=autolux
DB2_PASS=autolux

# API Node.js de fornecedores
API_PORT=3000
API_FORNECEDORES_URL=http://127.0.0.1:3000

# URL pública da app PHP (usada pela fonte B)
APP_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------
# Configuração partilhada pela aplicação PHP e pelo serviço Node.js.
# Copiar para .env e ajustar às credenciais da máquina onde corre.
# (Os valores por omissão correspondem a uma instalação XAMPP/WAMP.)
# ------------------------------------------------------------------

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Base de Dados 1 - clientes, material/stock e vendas (usada pelo PHP)
DB_VENDAS=autolux_vendas

# Base de Dados 2 - fornecedores e encomendas (usada pelo Node.js)
DB_COMPRAS=autolux_compras

# --- Serviço Node.js (API de compras) ---
API_PORT=3001

# --- Interface de gestão PHP ---
WEB_PORT=8000

# URL base que o PHP usa para falar com a API Node.js
API_BASE_URL=http://127.0.0.1:3001/api
